{
	"projects": {
		"default": "akashic-scramble"
	},
	"emulators": {
		"auth": {
			"port": 9099
		},
		"hosting": {
			"port": 5000
		},
		"ui": {
			"enabled": true
		},
		"singleProjectMode": true
	},
	"hosting": {
		"public": "public",
		"ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
		"rewrites": [
			{
				"source": "**",
				"destination": "/index.html"
			},
			{
				"source": "/my",
				"destination": "/index.html"
			},
			{
				"source": "/login",
				"destination": "/index.html"
			}
		],
		"headers": [
			{
				"source": "**",
				"headers": [
					{
						"key": "Cross-Origin-Opener-Policy",
						"value": "same-origin-allow-popups"
					}
				]
			}
		]
	}
}
